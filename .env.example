# Copia este archivo como ".env" y rellénalo. El archivo .env NO se sube a GitHub.
# Los datos salen de Supabase: botón "Connect" > "Session pooler".

DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
# En el pooler el usuario lleva el id del proyecto: postgres.xxxxxxxxxxxxxxxx
DB_USER=postgres.TU_ID_DE_PROYECTO
DB_PASSWORD=la-contraseña-de-tu-base-de-datos
DB_SSLMODE=require

# 1 muestra los errores en pantalla (solo en tu computador). En producción déjalo en 0.
APP_DEBUG=0
